# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=liana_user
DB_PASSWORD=liana_password
DB_DATABASE=liana_hr

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@liana-hr.com

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# For AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_S3_BUCKET=liana-hr-photos

# Socket.io
SOCKET_IO_CORS=http://localhost:5173
